<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Draw-over-apps permission for the desktop-pet floating bubble. User-granted via the system
         overlay screen; the pet stays inert until it is granted. -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Optional user-granted access; exact automation remains off by default. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Saving images to the gallery on pre-Q only; Q+ uses scoped MediaStore (no permission). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <!-- TTS engine is a cross-app TTS_SERVICE remote service; Android 11+ package visibility
         restrictions require this permission to bindService to system TTS engines (e.g. Xiaomi
         Mi Brain). Without it, TextToSpeech OnInit returns ERROR (-1) on MIUI. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" tools:ignore="QueryAllPackagesPermission" />
    <!-- ADB Shell: WRITE_SECURE_SETTINGS is no longer required by the Shizuku backend (Shizuku
         manages its own elevation), but is retained for backward compatibility with root-mode
         flows that may self-grant it via `pm grant`. Not dangerous-permission gated. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Local network discovery (mDNS / NSD) for LAN device discovery (independent of ADB). -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />
    <!-- SMS command system: receive and read SMS to recognize smsf# commands. User-granted at runtime. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <!-- Condition trigger system: query network state for NETWORK_CHANGE rules. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- system_* tools (P2/P3): phone call / SMS / media read & save / SAF files / radio / brightness /
         recording. All sensitive ones are runtime-granted with an in-app guidance page. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion" />
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" android:maxSdkVersion="30" />
    <!-- Brightness setting is a special app-op; user grants it on the SYSTEM_APPLICATIONS page. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Allows a visibility-safe preflight before using the platform capture contract. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.speech.tts.TTS_SERVICE" />
        </intent>
        <package android:name="com.xiaomi.mibrain.speech" />
        <package android:name="com.google.android.tts" />
        <package android:name="com.samsung.SMT" />
        <package android:name="com.huawei.hivoice" />
    </queries>

    <application
        android:name=".LxChatApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="true"
        android:theme="@style/Theme.LxChat.Starting">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.LxChat"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ProcessTextActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.LxChat.Starting">
            <intent-filter>
                <action android:name="android.intent.action.PROCESS_TEXT" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <provider
            android:name=".sandbox.SandboxDocumentsProvider"
            android:authorities="${applicationId}.documents"
            android:exported="true"
            android:grantUriPermissions="true"
            android:permission="android.permission.MANAGE_DOCUMENTS">
            <intent-filter>
                <action android:name="android.content.action.DOCUMENTS_PROVIDER" />
            </intent-filter>
        </provider>

        <!-- Shizuku: provides ADB-level shell access without root. The Shizuku app must be
             installed and running, and the user must grant permission at runtime. -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />

        <service
            android:name=".service.LxChatForegroundService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Hosts the draggable desktop-pet bubble on the system overlay. Runs only while the user
             has granted SYSTEM_ALERT_WINDOW and the pet toggle is on. -->
        <service
            android:name=".pet.PetOverlayWindowService"
            android:foregroundServiceType="dataSync"
            android:exported="false" />

        <!-- Lets a text-only model read and act on the current app via the accessibility
             node tree. Inert until the user enables it in Accessibility settings. -->
        <service
            android:name=".androidcontrol.AndroidUiControllerService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false"
            android:label="@string/android_controller_service_label">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_controller_service" />
        </service>

        <!-- WorkManager owns the foreground lifecycle for scheduled automation runs. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Quick Settings tile: one-tap toggle of the Agent's automation toolset. -->
        <service
            android:name=".qs.AgentToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_agent"
            android:label="@string/qs_agent_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile: status + deep-link for the app-control accessibility bridge. -->
        <service
            android:name=".qs.AccessibilityTileService"
            android:exported="true"
            android:icon="@drawable/ic_qs_accessibility"
            android:label="@string/qs_accessibility_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Quick Settings tile: toggle the desktop-pet floating bubble. -->
        <service
            android:name=".qs.PetToggleTileService"
            android:exported="true"
            android:icon="@drawable/ic_pet"
            android:label="@string/qs_pet_tile_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- System notification auto-reply (listens for WeChat/whitelisted notifications and
             replies via the bound IM channel). Requires the user to grant Notification access. -->
        <service
            android:name=".notification.NotificationAutoReplyService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Fires a scheduled task; internal only. -->
        <receiver
            android:name=".automation.AutomationAlarmReceiver"
            android:exported="false" />

        <!-- Re-arms task alarms after reboot / app update. -->
        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- SMS command system: listens for incoming SMS, recognizes smsf# commands and dispatches
             them to SmsCommandExecutorService for local on-device execution (ADB Shell / AI / WiFi).
             Inert until the user enables it in Settings → SMS 命令 and grants RECEIVE_SMS. -->
        <receiver
            android:name=".sms.SmsCommandReceiver"
            android:exported="true">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Executes smsf# commands off the main thread. Internal only; started by SmsCommandReceiver. -->
        <service
            android:name=".sms.SmsCommandExecutorService"
            android:exported="false" />

        <!-- Condition trigger system: listens for battery changes and dispatches matching
             TriggerRules (BATTERY_LOW / BATTERY_HIGH / CHARGING_START / CHARGING_STOP) to
             TriggerExecutorService. Note: ACTION_BATTERY_CHANGED is a sticky protected broadcast;
             on Android O+ this static registration won't fire, so the app also registers it
             dynamically at startup (see AppContainer.startProcessServices). Kept here for older
             devices and to satisfy the manifest contract. -->
        <receiver
            android:name=".trigger.BatteryTriggerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BATTERY_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Condition trigger system: listens for connectivity changes and dispatches matching
             NETWORK_CHANGE TriggerRules to TriggerExecutorService. CONNECTIVITY_CHANGE is
             deprecated on N+ and not delivered to manifest receivers on O+; the app also
             registers it dynamically at startup. -->
        <receiver
            android:name=".trigger.NetworkTriggerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Executes triggered AI tasks off the main thread. Internal only; started by the
             trigger receivers. -->
        <service
            android:name=".trigger.TriggerExecutorService"
            android:exported="false" />
    </application>

</manifest>
