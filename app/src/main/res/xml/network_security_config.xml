<?xml version="1.0" encoding="utf-8"?>
<!--
  明文（http://）放行不再依赖系统层的逐条枚举：base-config 直接放开 cleartext，
  把「是否允许向公网明文传输凭据」的决策收口到应用层凭据守卫
  （HttpClient.guardCleartextCredentials + 设置页的 allow_cleartext_http 开关）。

  原因：
  1. 系统 NSC 无法表达"仅放行到公网的自托管 http 端点"这一用户意图——它要么全
     禁（本地/Tailscale 明文也会被拦），要么全放（绕不过应用层守卫）。
  2. 用户显式在设置页开启 allow_cleartext_http 后，若系统层仍拦截，会出现
     "设置开了、请求仍被系统拒"的落差。

  安全边界仍在：应用层守卫默认 fail-closed，只有用户显式开启才放行公网明文。
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>